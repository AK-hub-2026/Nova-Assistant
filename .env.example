# GEMINI_API_KEY: Required for Gemini AI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GROQ_API_KEY: Optional key for Groq Cloud fast inference adapter.
GROQ_API_KEY=MY_GROQ_API_KEY

# OPENAI_API_KEY: Optional key for OpenAI-compatible provider adapter.
OPENAI_API_KEY=MY_OPENAI_API_KEY

# ELEVENLABS_API_KEY: Key for ElevenLabs Text-to-Speech API.
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY

